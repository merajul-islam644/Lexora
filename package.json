{
  "name": "lexora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lexora — multi-tenant SaaS for private business constructed languages",
  "scripts": {
    "dev:web": "vite",
    "cert": "node scripts/generate-cert.mjs",
    "function:build": "node scripts/build-function.mjs",
    "build": "tsc -p tsconfig.function.json && vite build",
    "typecheck": "tsc -p tsconfig.function.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@seliseblocks/client": "^0.3.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "sonner": "^2.0.8",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "selfsigned": "^2.4.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
